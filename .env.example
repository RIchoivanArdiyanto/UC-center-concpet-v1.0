# ── Port host (dipilih agar tidak bentrok dengan project Docker lain) ───────
WEB_PORT=8090

# ── MySQL 8 ────────────────────────────────────────────────────────────────
DB_NAME=uccenters
DB_USER=uccenters
DB_PASSWORD=uccenters
# Password root MySQL. WAJIB diganti di server.
DB_ROOT_PASSWORD=rootpassword

# Dipakai saat menjalankan `npm run dev` / prisma dari HOST (bukan di dalam
# Docker). Host = localhost, port = port yang di-publish docker-compose.override.
DATABASE_URL="mysql://uccenters:uccenters@localhost:3310/uccenters"

# ── NextAuth ───────────────────────────────────────────────────────────────
# WAJIB diisi. Minimal 32 karakter. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="uc_centers_super_secret_jwt_key_32_chars_min"
NEXTAUTH_URL="http://localhost:8090"

# ── Akun admin awal yang dibuat oleh seed ──────────────────────────────────
SEED_ADMIN_EMAIL="admin@uccenters.id"
SEED_ADMIN_USERNAME="superadmin"
# GANTI di produksi. Nilai ini menjadi password login pertama.
SEED_ADMIN_PASSWORD="Password123!"

# Set true untuk melewati seeding saat kontainer start
SKIP_SEED=false

# ── Berkas unggahan ────────────────────────────────────────────────────────
# Di Docker sudah diset ke /app/uploads (volume). Isi hanya bila menjalankan
# `npm run dev` di host dan ingin lokasi lain.
# UPLOAD_DIR="./uploads"
