// ============================================================
// UC Centers — Prisma Schema (MySQL 8)
// ============================================================
// Catatan desain:
// - Semua password disimpan sebagai hash (passwordHash), bukan plaintext.
//   Hashing (bcrypt cost 12) dilakukan di application layer, BUKAN di
//   database — schema hanya menyediakan kolomnya.
// - onDelete: Cascade dipakai untuk data anak yang tidak berguna tanpa
//   induknya (mis. TeamMember tanpa Center). Untuk Lead sengaja TIDAK
//   cascade agar riwayat lead tetap ada walau Center dihapus (SetNull).
// - Slug dipakai untuk URL publik (bukan id/cuid) supaya URL rapi & SEO-friendly.
// - ActivityLog TIDAK otomatis terisi oleh database — harus ditulis eksplisit
//   di setiap mutation di application layer.
//
// CATATAN MySQL (berbeda dari versi PostgreSQL sebelumnya):
// - Prisma memetakan `String` ke VARCHAR(191) di MySQL. Itu terlalu pendek
//   untuk URL dan teks ringkasan, dan kelebihannya akan DIPOTONG/ditolak saat
//   insert. Karena itu setiap kolom yang bisa panjang diberi @db.VarChar(...)
//   atau @db.Text secara eksplisit.
// - Scalar list (`String[]`) TIDAK didukung MySQL. Daftar permission karena itu
//   disimpan sebagai kolom Json.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// AUTH & ADMIN
// ------------------------------------------------------------

// Lingkup akses sebuah role. Menentukan apakah pemiliknya melihat seluruh
// center atau hanya center yang ditugaskan padanya. Penegakannya di
// application layer (lib/api.ts) — schema tidak bisa memaksanya sendiri.
enum AdminScope {
  ALL_CENTERS
  OWN_CENTER
}

// Role menggantikan enum AdminRole yang lama. Dengan tabel sendiri, admin bisa
// membuat role baru dan mengatur hak aksesnya dari panel tanpa deploy ulang.
model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?    @db.VarChar(500)
  scope       AdminScope @default(OWN_CENTER)
  // Array kunci permission (lihat lib/permissions.ts) dalam bentuk JSON.
  // MySQL tidak punya tipe array seperti Postgres, jadi kolom Json adalah
  // padanan terdekat. Pembacaannya lewat parsePermissions() supaya isi yang
  // rusak/legacy tidak membuat aplikasi crash.
  permissions Json
  // Role bawaan sistem tidak boleh dihapus agar tidak ada admin yang terkunci
  // di luar sistemnya sendiri.
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users AdminUser[]
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique // dipakai untuk login selain email
  email        String    @unique
  passwordHash String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  centerId     String? // wajib diisi untuk role ber-scope OWN_CENTER
  center       Center?   @relation(fields: [centerId], references: [id], onDelete: SetNull)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  articles     Article[]
  activityLogs ActivityLog[]
  handledLeads Lead[]        @relation("LeadHandledBy")

  @@index([centerId])
  @@index([roleId])
}

// ------------------------------------------------------------
// TAXONOMY (dipakai bersama oleh Center, Portfolio, Artikel)
// ------------------------------------------------------------

model ExpertiseTag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  colorHex  String?  @db.VarChar(9) // #RRGGBB atau #RRGGBBAA
  createdAt DateTime @default(now())

  centers  CenterExpertise[]
  projects ProjectExpertise[]
}

// ------------------------------------------------------------
// CENTER
// ------------------------------------------------------------

enum HeroMediaType {
  IMAGE
  VIDEO
}

model Center {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(255)
  slug          String        @unique
  tagline       String?       @db.VarChar(500)
  logoUrl       String?       @db.VarChar(1000)
  heroMediaType HeroMediaType @default(IMAGE)
  heroMediaUrl  String?       @db.VarChar(1000) // image URL ATAU embed URL video
  aboutContent  String?       @db.Text
  profilePdfUrl String?       @db.VarChar(1000) // tombol "Unduh Profil"
  isPublished   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  expertiseTags CenterExpertise[]
  services      CenterService[]
  team          TeamMember[]
  clientLogos   ClientLogo[]
  projects      PortfolioProject[]
  admins        AdminUser[]
  leads         Lead[]

  @@index([isPublished])
}

model CenterExpertise {
  centerId String
  tagId    String
  center   Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tag      ExpertiseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([centerId, tagId])
  @@index([tagId])
}

model CenterService {
  id          String  @id @default(cuid())
  centerId    String
  center      Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  title       String  @db.VarChar(255)
  description String? @db.VarChar(1000)
  sortOrder   Int     @default(0)

  @@index([centerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(255)
  role      String   @db.VarChar(255)
  email     String? // ditampilkan di halaman center saat namanya diklik
  photoUrl  String?  @db.VarChar(1000)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([centerId])
}

model ClientLogo {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(255)
  logoUrl   String   @db.VarChar(1000)
  centerId  String? // null = tampil global (Beranda), diisi = khusus 1 center
  center    Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([centerId])
}

// ------------------------------------------------------------
// PORTFOLIO
// ------------------------------------------------------------

model PortfolioProject {
  id               String   @id @default(cuid())
  centerId         String
  center           Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  title            String   @db.VarChar(255)
  slug             String   @unique
  summary          String?  @db.VarChar(1000)
  caseStudyContent String?  @db.Text
  coverImageUrl    String?  @db.VarChar(1000)
  videoEmbedUrl    String?  @db.VarChar(1000) // opsional, embed YouTube/Vimeo
  isHighlighted    Boolean  @default(false) // tampil di Beranda
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  expertiseTags ProjectExpertise[]

  @@index([centerId])
  @@index([isHighlighted])
  @@index([isPublished])
}

model ProjectExpertise {
  projectId String
  tagId     String
  project   PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       ExpertiseTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
}

// ------------------------------------------------------------
// ARTIKEL
// ------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Article {
  id             String           @id @default(cuid())
  title          String           @db.VarChar(255)
  slug           String           @unique
  summary        String?          @db.VarChar(1000)
  content        String           @db.LongText
  coverImageUrl  String?          @db.VarChar(1000)
  categoryId     String?
  category       ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status         ArticleStatus    @default(DRAFT)
  publishedAt    DateTime?
  seoTitle       String?          @db.VarChar(255)
  seoDescription String?          @db.VarChar(500)
  authorId       String?
  author         AdminUser?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attachments ArticleAttachment[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model ArticleAttachment {
  id            String   @id @default(cuid())
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  fileUrl       String   @db.VarChar(1000)
  fileName      String   @db.VarChar(255)
  fileSizeBytes Int?
  mimeType      String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  @@index([articleId])
}

// ------------------------------------------------------------
// LEADS (form Konsultasi / Ajukan Kerja Sama / Hubungi Center)
// ------------------------------------------------------------

enum LeadSource {
  HOMEPAGE
  CENTER_DETAIL
  GENERAL_CONSULTATION
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id          String     @id @default(cuid())
  centerId    String?
  center      Center?    @relation(fields: [centerId], references: [id], onDelete: SetNull)
  name        String     @db.VarChar(255)
  email       String     @db.VarChar(255)
  phone       String?    @db.VarChar(50)
  subject     String?    @db.VarChar(255) // judul singkat dari form Kontak
  message     String?    @db.Text
  source      LeadSource
  status      LeadStatus @default(NEW)
  handledById String?
  handledBy   AdminUser? @relation("LeadHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([centerId])
  @@index([status])
  @@index([handledById])
  @@index([createdAt])
}

// ------------------------------------------------------------
// ACTIVITY LOG
// ------------------------------------------------------------

model ActivityLog {
  id         String    @id @default(cuid())
  actorId    String
  actor      AdminUser @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String    @db.VarChar(50)
  entityType String    @db.VarChar(50)
  entityId   String
  metadata   Json? // simpan before/after value kalau perlu audit detail
  createdAt  DateTime  @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
}

// ------------------------------------------------------------
// SITE SETTINGS (konten beranda, kontak, media sosial)
// ------------------------------------------------------------

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
